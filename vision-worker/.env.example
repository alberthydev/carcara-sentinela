VISION_PORT=8000
CORS_ORIGIN=http://localhost:5173
# Habilite somente quando houver uma câmera RTSP autorizada para testes.
VISION_RTSP_ENABLED=false
# VISION_CAMERAS_FILE=/caminho/privado/cameras.json
# VISION_API_URL=http://localhost:3000
VISION_INGEST_TOKEN=
VISION_RTSP_QUEUE_SIZE=64
# Exporte as variáveis no ambiente do processo. OpenCV é a linha de base.
VISION_DETECTOR=opencv
VISION_EVERY=5
# VISION_ROI=250,500,900,400
# VISION_VEHICLE_MODEL=/models/yolox_nano.onnx
# VISION_PLATE_MODEL=/models/plate.onnx
VISION_YOLO_DEVICE=cpu
VISION_VEHICLE_SIZE=416
VISION_PLATE_SIZE=640
VISION_VEHICLE_CONFIDENCE=0.25
VISION_PLATE_CONFIDENCE=0.25
VISION_OCR_WINDOW=3
VISION_OCR_BEST=1
# Linha vertical no frame original, opcional para diagnóstico por upload.
# VISION_PASSAGE_LINE_X=640
VISION_PASSAGE_ENTRY=right
